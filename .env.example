# Copy to .env locally if you use a dotenv loader, or set in the shell.
# NEVER commit real keys. .env is gitignored.

GEMINI_API_KEY=
# Optional alias:
# SYNTH_LLM_API_KEY=

# Optional model overrides:
# SYNTH_GEMINI_MODEL=gemini-3.8-flash
# Automatic fallback sequence on 503/429/404:
# gemini-3.7-flash -> gemini-3.1-flash-lite -> gemini-3.5-flash
# SYNTH_GEMINI_FALLBACK_MODEL=gemini-3.7-flash
