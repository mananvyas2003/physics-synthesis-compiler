# Copy to .env locally if you use a dotenv loader, or set in the shell.
# NEVER commit real keys. .env is gitignored.
#
# Google AI Studio keys look like: AIza...
# Put the same value in GEMINI_API_KEY.local (one line) for Cursor-friendly local use.
# Seed DEMO catalogue parts (LED/C/L/…):  python scripts/seed_catalogue.py
# Fixture/seed generate with catalogue:   set SYNTH_ALLOW_IR_PARTS=1  (CI default)

GEMINI_API_KEY=
# Optional alias:
# SYNTH_LLM_API_KEY=

# Optional model overrides:
# SYNTH_GEMINI_MODEL=gemini-3.8-flash
# Automatic fallback sequence on 503/429/404:
# gemini-3.7-flash -> gemini-3.1-flash-lite -> gemini-3.5-flash
# SYNTH_GEMINI_FALLBACK_MODEL=gemini-3.7-flash
